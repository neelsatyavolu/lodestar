{
  // Lodestar fares service: the Python container behind a token-checking Worker.
  // Deploy: CLOUDFLARE_ACCOUNT_ID=<your account> pnpm exec wrangler deploy (Docker must be running).
  "name": "lodestar-fares",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-15",
  "workers_dev": false,
  "routes": [{ "pattern": "lodestar-fares.xanom.co", "custom_domain": true }],
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "FaresContainer",
      "image": "../Dockerfile",
      "image_build_context": "..",
      // Chromium needs room: 1 vCPU, 6 GiB.
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "FARES", "class_name": "FaresContainer" }]
  },
  "exports": {
    "FaresContainer": { "type": "durable-object", "storage": "sqlite" }
  }
}
