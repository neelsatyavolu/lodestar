{
  "name": "lodestar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-maplibre-worker.mjs && next dev",
    "dev:fares": "cd fares && .venv/bin/uvicorn lodestar_fares.app:app --host 127.0.0.1 --port 8787",
    "build": "node scripts/copy-maplibre-worker.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:fares": "cd fares && .venv/bin/python -m pytest -q",
    "typecheck": "next typegen && tsc --noEmit",
    "build:airports": "node scripts/build-airports.mjs",
    "smoke": "vitest run --config vitest.smoke.config.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2",
    "@neelsatyavolu/shared-ai-auth": "github:neelsatyavolu/shared-ai-auth#bce03a005bee",
    "@vercel/functions": "^3.10.5",
    "geist": "^1.9.0",
    "jose": "^6",
    "lucide-react": "^1.66.0",
    "maplibre-gl": "^6.16.0",
    "mcp-handler": "^2.3.1",
    "next": "16.4.2",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4"
  }
}
